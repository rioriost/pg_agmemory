+    Oid graph_namespace_oid;
+    Oid label_table_oid;
+    char *qualified_name;
+    char *query;
+    SPIPlanPtr plan;
+    Portal portal;
+
+    graph_namespace_oid = get_namespace_oid(ggctx->graph_name, false);
+    label_table_oid = get_relname_relid(label_name, graph_namespace_oid);
+    if (!OidIsValid(label_table_oid))
+    {
+        ereport(ERROR,
+                (errcode(ERRCODE_UNDEFINED_TABLE),
+                 errmsg("graph label table %s.%s does not exist",
+                        ggctx->graph_name, label_name)));
+    }
+
+    qualified_name = quote_qualified_identifier(ggctx->graph_name, label_name);
+    if (label_type == LABEL_TYPE_VERTEX)
+    {
+        query = psprintf("SELECT ctid AS age_ctid, id FROM ONLY %s",
+                         qualified_name);
+    }
+    else
+    {
+        query = psprintf("SELECT ctid AS age_ctid, id, start_id, end_id "
+                         "FROM ONLY %s", qualified_name);
+    }
+
+    plan = SPI_prepare(query, 0, NULL);
+    if (plan == NULL)
+    {
+        elog(ERROR, "could not prepare RLS-aware graph scan for %s: %s",
+             qualified_name, SPI_result_code_string(SPI_result));
+    }
+
+    portal = SPI_cursor_open(NULL, plan, NULL, NULL, true);
+    if (portal == NULL)
+    {
+        elog(ERROR, "could not open RLS-aware graph scan for %s",
+             qualified_name);
+    }
+
+    for (;;)
+    {
+        SPITupleTable *tuptable;
+        TupleDesc tupdesc;
+        uint64 row;
+
+        SPI_cursor_fetch(portal, true, RLS_SCAN_BATCH_SIZE);
+        if (SPI_processed == 0)
+        {
+            break;
+        }
+
+        tuptable = SPI_tuptable;
+        tupdesc = tuptable->tupdesc;
+
+        for (row = 0; row < SPI_processed; row++)
+        {
+            HeapTuple tuple = tuptable->vals[row];
+            ItemPointerData tid;
+            Datum datum;
+            graphid entity_id;
+            bool isnull;
+            MemoryContext oldctx;
+
+            datum = SPI_getbinval(tuple, tupdesc, 1, &isnull);
+            if (isnull)
+            {
+                elog(ERROR, "RLS-aware graph scan returned a null ctid");
+            }
+            ItemPointerCopy((ItemPointer) DatumGetPointer(datum), &tid);
+
+            datum = SPI_getbinval(tuple, tupdesc, 2, &isnull);
+            if (isnull)
+            {
+                elog(ERROR, "RLS-aware graph scan returned a null graph id");
+            }
+            entity_id = DatumGetInt64(datum);
+
+            if (hash_search(base_visible_ids, &entity_id, HASH_FIND, NULL) ==
+                NULL)
+            {
+                continue;
+            }
+
+            /* adjacency arrays and the cleanup list must survive SPI_finish */
+            oldctx = MemoryContextSwitchTo(TopMemoryContext);
+
+            if (label_type == LABEL_TYPE_VERTEX)
+            {
+                if (!insert_vertex_entry(ggctx, entity_id, label_table_oid,
+                                         tid))
+                {
+                    ereport(WARNING,
+                            (errcode(ERRCODE_DATA_EXCEPTION),
+                             errmsg("ignored duplicate vertex")));
+                }
+            }
+            else
+            {
+                graphid start_id;
+                graphid end_id;
+                bool isnull_start;
+                bool isnull_end;
+                bool inserted;
+
+                datum = SPI_getbinval(tuple, tupdesc, 3, &isnull_start);
+                start_id = isnull_start ? 0 : DatumGetInt64(datum);
+                datum = SPI_getbinval(tuple, tupdesc, 4, &isnull_end);
+                end_id = isnull_end ? 0 : DatumGetInt64(datum);
+                if (isnull_start || isnull_end)
+                {
+                    elog(ERROR,
+                         "RLS-aware graph scan returned a null edge endpoint");
+                }
+
+                /*
+                 * An edge is traversable only when RLS exposed both endpoint
+                 * vertices.  Skip it before either adjacency list is changed.
+                 */
+                if (get_vertex_entry(ggctx, start_id) == NULL ||
+                    get_vertex_entry(ggctx, end_id) == NULL)
+                {
+                    MemoryContextSwitchTo(oldctx);
+                    continue;
+                }
+
+                inserted = insert_edge_entry(ggctx, entity_id, tid, start_id,
+                                             end_id, label_table_oid);
+                if (!inserted)
+                {
+                    ereport(WARNING,
+                            (errcode(ERRCODE_DATA_EXCEPTION),
+                             errmsg("ignored duplicate edge")));
+                }
+                else if (!insert_vertex_edge(ggctx, start_id, end_id,
+                                             entity_id, label_name))
+                {
+                    elog(ERROR, "visible edge has a missing endpoint");
+                }
+            }
+
+            MemoryContextSwitchTo(oldctx);
+        }
+
+        SPI_freetuptable(tuptable);
+    }
+
+    SPI_cursor_close(portal);
+    SPI_freeplan(plan);
+    pfree(query);
+    pfree(qualified_name);
+}
