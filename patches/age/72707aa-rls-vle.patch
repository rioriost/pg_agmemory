+/*
+ * Collect rows visible through the inherited base label. PostgreSQL applies
+ * the base relation's RLS policy to every descendant selected this way.
+ */
+static void load_rls_base_visibility(GRAPH_global_context *ggctx,
+                                     char label_type,
+                                     HTAB *base_visible_ids)
+{
+    const char *base_label_name;
+    char *qualified_name;
+    char *query;
+    SPIPlanPtr plan;
+    Portal portal;
+
+    base_label_name = label_type == LABEL_TYPE_VERTEX
+                          ? AG_DEFAULT_LABEL_VERTEX
+                          : AG_DEFAULT_LABEL_EDGE;
+    qualified_name = quote_qualified_identifier(ggctx->graph_name,
+                                                base_label_name);
+    query = psprintf("SELECT id FROM %s", qualified_name);
+
+    plan = SPI_prepare(query, 0, NULL);
+    if (plan == NULL)
+    {
+        elog(ERROR, "could not prepare base-label RLS scan for %s: %s",
+             qualified_name, SPI_result_code_string(SPI_result));
+    }
+
+    portal = SPI_cursor_open(NULL, plan, NULL, NULL, true);
+    if (portal == NULL)
+    {
+        elog(ERROR, "could not open base-label RLS scan for %s",
+             qualified_name);
+    }
+
+    for (;;)
+    {
+        SPITupleTable *tuptable;
+        TupleDesc tupdesc;
+        uint64 row;
+
+        SPI_cursor_fetch(portal, true, RLS_SCAN_BATCH_SIZE);
+        if (SPI_processed == 0)
+        {
+            break;
+        }
+
+        tuptable = SPI_tuptable;
+        tupdesc = tuptable->tupdesc;
+        for (row = 0; row < SPI_processed; row++)
+        {
+            Datum datum;
+            graphid entity_id;
+            bool isnull;
+
+            datum = SPI_getbinval(tuptable->vals[row], tupdesc, 1, &isnull);
+            if (isnull)
+            {
+                elog(ERROR,
+                     "base-label RLS scan returned a null graph id");
+            }
+            entity_id = DatumGetInt64(datum);
+            hash_search(base_visible_ids, &entity_id, HASH_ENTER, NULL);
+        }
+
+        SPI_freetuptable(tuptable);
+    }
+
+    SPI_cursor_close(portal);
+    SPI_freeplan(plan);
+    pfree(query);
+    pfree(qualified_name);
+}
+
+/* Populate a statement-local, RLS-filtered view of the whole graph. */
+static void load_rls_GRAPH_global_hashtables(GRAPH_global_context *ggctx)
+{
+    static const char label_types[] = {LABEL_TYPE_VERTEX, LABEL_TYPE_EDGE};
+    Snapshot snapshot = GetActiveSnapshot();
+    int i;
+
+    ggctx->num_loaded_vertices = 0;
+    ggctx->num_loaded_edges = 0;
+
+    if (SPI_connect() != SPI_OK_CONNECT)
+    {
+        elog(ERROR, "could not connect to SPI for RLS-aware graph loading");
+    }
+
+    for (i = 0; i < lengthof(label_types); i++)
+    {
+        HASHCTL ctl;
+        List *label_names;
+        ListCell *lc;
+        HTAB *base_visible_ids;
+        MemoryContext visibility_mcxt;
+
+        visibility_mcxt = AllocSetContextCreate(
+            ggctx->edge_table_mcxt, "AGE RLS base visibility",
+            ALLOCSET_DEFAULT_SIZES);
+        MemSet(&ctl, 0, sizeof(ctl));
+        ctl.keysize = sizeof(graphid);
+        ctl.entrysize = sizeof(graphid);
+        ctl.hash = graphid_hash;
+        ctl.hcxt = visibility_mcxt;
+        base_visible_ids = hash_create("AGE RLS base-visible IDs",
+                                       VERTEX_HTAB_INITIAL_SIZE, &ctl,
+                                       HASH_ELEM | HASH_FUNCTION |
+                                       HASH_CONTEXT);
+
+        load_rls_base_visibility(ggctx, label_types[i], base_visible_ids);
+
+        label_names = get_ag_labels_names(snapshot, ggctx->graph_oid,
+                                          label_types[i]);
+        foreach (lc, label_names)
+        {
+            load_rls_label_table(ggctx, lfirst(lc), label_types[i],
+                                 base_visible_ids);
+        }
+        list_free_deep(label_names);
+        MemoryContextDelete(visibility_mcxt);
+    }
+
+    if (SPI_finish() != SPI_OK_FINISH)
+    {
+        elog(ERROR, "could not finish SPI RLS-aware graph loading");
+    }
+}
