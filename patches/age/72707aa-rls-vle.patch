+/*
+ * Load one label through PostgreSQL's normal parser, rewriter, planner, and
+ * executor.  In particular, the rewriter attaches row-security quals and the
+ * executor performs the table privilege check that a raw table scan bypasses.
+ * ONLY is required because every AGE label is an inheritance child and the
+ * label catalog already gives us each physical table exactly once.  A child
+ * row must also be visible through the base label: typed Cypher can use the
+ * child policy while an untyped pattern uses the inherited base-table policy,
+ * and this query-independent graph cache must be safe for both forms.  The
+ * caller supplies the IDs returned by one base-table scan so that applying
+ * both policy layers remains linear in graph size.
+ */
+static void load_rls_label_table(GRAPH_global_context *ggctx,
+                                 char *label_name, char label_type,
+                                 HTAB *base_visible_ids)
