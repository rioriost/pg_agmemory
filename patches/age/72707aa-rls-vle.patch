+/*
+ * Return true when row security applies to at least one label table for the
+ * current effective user.  check_enable_rls() deliberately distinguishes an
+ * enabled policy from an owner/superuser/BYPASSRLS bypass, so the fast graph
+ * cache remains available to roles for which PostgreSQL would not add row
+ * security quals.
+ */
+static bool graph_has_enabled_rls(char *graph_name, Oid graph_oid)
+{
+    static const char label_types[] = {LABEL_TYPE_VERTEX, LABEL_TYPE_EDGE};
+    Oid graph_namespace_oid;
+    Snapshot snapshot;
+    int i;
+
+    graph_namespace_oid = get_namespace_oid(graph_name, false);
+    snapshot = GetActiveSnapshot();
+
+    for (i = 0; i < lengthof(label_types); i++)
+    {
+        List *label_names;
+        ListCell *lc;
+
+        label_names = get_ag_labels_names(snapshot, graph_oid,
+                                          label_types[i]);
+        foreach (lc, label_names)
+        {
+            char *label_name = lfirst(lc);
+            Oid relid = get_relname_relid(label_name, graph_namespace_oid);
+
+            if (!OidIsValid(relid))
+            {
+                ereport(ERROR,
+                        (errcode(ERRCODE_UNDEFINED_TABLE),
+                         errmsg("graph label table %s.%s does not exist",
+                                graph_name, label_name)));
+            }
+
+            if (check_enable_rls(relid, InvalidOid, true) == RLS_ENABLED)
+            {
+                list_free_deep(label_names);
+                return true;
+            }
+        }
+
+        list_free_deep(label_names);
+    }
+
+    return false;
